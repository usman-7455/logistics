@model List<logistics.Models.ViewModels.OrderSummaryViewModel>

@{
    ViewData["Title"] = "All Orders";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-receipt"></i> Order History</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Order
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Total Bill</th>
                                <th>Status</th>
                                <th>Tracking Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>#@order.OrderId</strong></td>
                                    <td>
                                        <div class="fw-bold">@order.CustomerName</div>
                                        <small class="text-muted">@order.CustomerEmail</small>
                                    </td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="fw-bold text-success">@order.TotalAmount.ToString("C")</td>
                                    <td>
                                        @if (order.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">@order.Status</span>
                                        }
                                        else if (order.Status == "Shipped")
                                        {

                                            <span class="badge bg-info text-dark">@order.Status</span>
                                        }
                                        else if (order.Status == "Delivered")
                                        {

                                            <span class="badge bg-success">@order.Status</span>
                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary">@order.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(order.TrackingCode))
                                        {
                                            <span class="badge bg-primary">@order.TrackingCode</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Pending Dispatch</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4">No orders have been placed yet.</p>
            }
        </div>
    </div>
</div>