@model List<logistics.Models.ViewModels.PendingShipmentViewModel>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table modern-table mb-0">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Order Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var shipment in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">#@shipment.OrderId</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@shipment.CustomerName</div>
                                </td>
                                <td>
                                    <span class="text-muted">@shipment.OrderDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">@shipment.TotalAmount.ToString("C")</span>
                                </td>
                                <td>
                                    <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2">
                                        <i class="bi bi-clock-fill me-1"></i>@shipment.CurrentStatus
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="AssignDriver" asp-route-id="@shipment.ShipmentId" class="btn btn-assign-driver">
                                        <i class="bi bi-person-plus-fill me-2"></i>Assign Driver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <!-- Premium Empty State -->
    <div class="empty-state text-center">
        <div class="bg-white rounded-circle d-inline-flex p-4 mb-3 shadow-sm">
            <i class="bi bi-truck display-4 text-muted"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">All caught up!</h4>
        <p class="text-muted mb-0">
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
            {
                <span>No pending shipments found matching "<strong>@ViewData["CurrentFilter"]</strong>".</span>
            }
            else
            {
                <span>There are no pending shipments at this time. New orders will appear here.</span>
            }
        </p>
        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
        {
            <button type="button" id="clearSearchBtn" class="btn btn-outline-primary px-4 mt-3">
                <i class="bi bi-x-circle me-2"></i>Clear Search
            </button>
        }
    </div>
}