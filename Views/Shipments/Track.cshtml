@model logistics.Models.ViewModels.TrackingResultViewModel

@{
    ViewData["Title"] = "Track Shipment";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Search Form -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-search"></i> Track Your Package</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Track" method="get" class="d-flex gap-2">
                        <input type="text" name="code" class="form-control" placeholder="Enter Tracking Code (e.g., TRK-20260828-1234)" value="@Model?.TrackingCode" required />
                        <button type="submit" class="btn btn-primary">Track</button>
                    </form>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3 mb-0">@ViewBag.Error</div>
                    }
                </div>
            </div>

            <!-- Tracking Results -->
            @if (Model != null)
            {
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Tracking Details</h4>
                        <span class="badge bg-light text-dark fs-6">@Model.TrackingCode</span>
                    </div>
                    <div class="card-body">
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="text-muted">Delivery Status</h6>
                                <h3 class="text-primary fw-bold">@Model.Status</h3>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Estimated Delivery</h6>
                                <h5>@Model.EstimatedDeliveryTime?.ToString("MMM dd, yyyy - hh:mm tt")</h5>
                            </div>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Customer Details</h6>
                                <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
                                <p class="mb-0"><strong>Email:</strong> @Model.CustomerEmail</p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted mb-2">Driver Information</h6>
                                <p class="mb-0"><strong>Assigned Driver:</strong> @Model.DriverName</p>
                            </div>
                        </div>

                        <hr />

                        <h6 class="text-muted mb-2">Package Contents</h6>
                        <ul class="list-group list-group-flush mb-4">
                            @foreach (var item in Model.OrderItemsSummary)
                            {
                                <li class="list-group-item">@item</li>
                            }
                        </ul>

                        <hr />

                        <!-- Admin Action: Mark as Delivered -->
                        @if (Model.Status != "Delivered")
                        {
                            <div class="mt-3 p-3 bg-light rounded border">
                                <h6 class="text-muted mb-2"><i class="bi bi-shield-lock"></i> Admin Action</h6>
                                <p class="small text-muted mb-2">Click below to confirm the package has been successfully delivered to the customer.</p>
                                <form asp-action="MarkAsDelivered" method="post">
                                    <input type="hidden" name="code" value="@Model.TrackingCode" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="bi bi-check-circle"></i> Mark as Delivered
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="mt-3 p-3 bg-success bg-opacity-10 rounded border border-success text-center">
                                <h5 class="text-success mb-0"><i class="bi bi-check-circle-fill"></i> This order has been successfully delivered!</h5>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>