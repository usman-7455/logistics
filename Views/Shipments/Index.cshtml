@model List<logistics.Models.ViewModels.PendingShipmentViewModel>

@{
    ViewData["Title"] = "Pending Shipments";
    Layout = "_Layout";
}

<style>
    /* Modern Table Styling */
    .modern-table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        margin-bottom: 0;
    }

        .modern-table thead th {
            background: #1e293b;
            border-bottom: 3px solid #0d6efd;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1.2px;
            color: #f8f9fa;
            padding: 1.25rem 1.5rem;
            white-space: nowrap;
        }

        .modern-table tbody tr {
            transition: all 0.2s ease;
            background: #ffffff;
        }

            .modern-table tbody tr:hover {
                background: #f8f9fa;
                transform: translateY(-1px);
                box-shadow: 0 4px 6px rgba(0,0,0,0.02);
                z-index: 1;
                position: relative;
            }

        .modern-table td {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #f1f3f5;
            vertical-align: middle;
            color: #334155;
            white-space: nowrap;
        }

    .search-container {
        position: relative;
    }

    .search-input {
        border-radius: 10px;
        border: 1px solid #dee2e6;
        padding: 0.75rem 1rem 0.75rem 2.5rem;
        transition: all 0.3s ease;
        background: #f8f9fa;
        width: 100%;
    }

        .search-input:focus {
            background: #ffffff;
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
            outline: none;
        }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        pointer-events: none;
        z-index: 2;
    }

    .btn-modern-primary {
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }

        .btn-modern-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
        }

    .btn-modern-outline {
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: 1px solid #dee2e6;
        background: #ffffff;
        color: #495057;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .btn-modern-outline:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
            transform: translateY(-1px);
            color: #0d6efd;
        }

    .btn-assign-driver {
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        border: none;
        background: #0d6efd;
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .btn-assign-driver:hover {
            background: #0b5ed7;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
            color: white;
        }

    .empty-state {
        padding: 4rem 2rem;
        background: #f8f9fa;
        border-radius: 12px;
        border: 2px dashed #dee2e6;
    }

    /* RESPONSIVE TABLE ADJUSTMENTS */
    @@media (max-width: 768px) {
        .modern-table thead th, .modern-table td {
            padding: 1rem 0.75rem;
            font-size: 0.9rem;
        }

            .modern-table th:first-child,
            .modern-table td:first-child {
                position: sticky;
                left: 0;
                z-index: 2;
                box-shadow: 2px 0 5px rgba(0,0,0,0.1);
                background-color: #ffffff;
            }

        .modern-table th:first-child {
            z-index: 3;
            background: #1e293b !important;
        }
    }

    /* Loading Spinner for Dynamic Search */
    .search-loading {
        display: none;
        text-align: center;
        padding: 3rem;
    }

        .search-loading.active {
            display: block;
        }
</style>

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Page Header -->
    <div class="row mb-4 align-items-center g-3">
        <div class="col-12 col-md-6">
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-truck me-2 text-primary"></i>Pending Shipments
            </h2>
            <p class="text-muted mb-0 mt-1 small">Review and assign drivers to active shipments</p>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <div class="d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                <!-- Dynamic Search Input (No Form Tag to Prevent Page Reload) -->
                <div class="d-flex gap-2" style="max-width: 350px; width: 100%;">
                    <div class="search-container flex-grow-1">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" id="dynamicSearchInput" value="@ViewData["CurrentFilter"]"
                               class="form-control search-input" placeholder="Type customer or ID..." autocomplete="off" />
                    </div>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                    {
                        <button type="button" id="clearSearchBtn" class="btn btn-outline-secondary d-flex align-items-center justify-content-center" style="border-radius: 10px; width: 46px;">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    }
                </div>

                <!-- Track Button -->
                <a asp-action="Track" class="btn btn-modern-outline">
                    <i class="bi bi-geo-alt me-2"></i>Track Package
                </a>
            </div>
        </div>
    </div>

    <!-- Success Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Dynamic Table Container -->
    <div id="shipment-table-wrapper">
        <!-- Loading Spinner (Hidden by default) -->
        <div id="search-loading" class="search-loading">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <!-- Initial Render of the Table -->
        @await Html.PartialAsync("_PendingShipmentTable", Model)
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('dynamicSearchInput');
            const tableContainer = document.getElementById('shipment-table-wrapper');
            const loadingSpinner = document.getElementById('search-loading');
            const clearBtn = document.getElementById('clearSearchBtn');

            let debounceTimer = null;

            // Listen for typing
            searchInput.addEventListener('input', function() {
                const query = this.value;

                // Clear previous timer (debounce)
                clearTimeout(debounceTimer);

                // Show loading state
                loadingSpinner.classList.add('active');

                // Wait 300ms after user stops typing before fetching
                debounceTimer = setTimeout(async () => {
                    try {
                        const response = await fetch(`/Shipments/SearchShipments?searchString=${encodeURIComponent(query)}`);
                        if (response.ok) {
                            const html = await response.text();
                            // Replace only the table part
                            tableContainer.innerHTML = html;

                            // Re-attach the clear button logic if it exists in the new HTML
                            const newClearBtn = document.getElementById('clearSearchBtn');
                            if (newClearBtn) {
                                newClearBtn.addEventListener('click', function(e) {
                                    e.preventDefault();
                                    searchInput.value = '';
                                    searchInput.dispatchEvent(new Event('input'));
                                    searchInput.focus();
                                });
                            }
                        }
                    } catch (error) {
                        console.error('Dynamic search failed:', error);
                    } finally {
                        // Hide loading state
                        loadingSpinner.classList.remove('active');
                    }
                }, 300); // 300ms debounce
            });

            // Initial clear button logic (if page loaded with a filter)
            if (clearBtn) {
                clearBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    searchInput.value = '';
                    searchInput.dispatchEvent(new Event('input'));
                    searchInput.focus();
                });
            }
        });
    </script>
}