@model List<logistics.Models.ViewModels.PendingShipmentViewModel>

@{
    ViewData["Title"] = "Pending Shipments";
    Layout = "_Layout";
}

<style>
    /* Modern Table Styling */
    .modern-table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        margin-bottom: 0;
    }

        /* ELEGANT & CONTRASTING HEADER */
        .modern-table thead th {
            background: #1e293b; /* Deep professional slate/dark blue */
            border-bottom: 3px solid #0d6efd; /* Subtle primary brand accent */
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1.2px;
            color: #f8f9fa; /* Crisp white text for high contrast */
            padding: 1.25rem 1.5rem;
            white-space: nowrap;
        }

        .modern-table tbody tr {
            transition: all 0.2s ease;
            background: #ffffff;
        }

            .modern-table tbody tr:hover {
                background: #f8f9fa;
                transform: translateY(-1px);
                box-shadow: 0 4px 6px rgba(0,0,0,0.02);
                z-index: 1;
                position: relative;
            }

        .modern-table td {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #f1f3f5;
            vertical-align: middle;
            color: #334155;
            white-space: nowrap;
        }

    /* UI Enhancements */
    .search-container {
        position: relative;
    }

    .search-input {
        border-radius: 10px;
        border: 1px solid #dee2e6;
        padding: 0.75rem 1rem 0.75rem 2.5rem;
        transition: all 0.3s ease;
        background: #f8f9fa;
        width: 100%;
    }

        .search-input:focus {
            background: #ffffff;
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.1);
            outline: none;
        }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
        pointer-events: none;
        z-index: 2;
    }

    .btn-modern-primary {
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: none;
    }

        .btn-modern-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
        }

    .btn-modern-outline {
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s ease;
        border: 1px solid #dee2e6;
        background: #ffffff;
        color: #495057;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .btn-modern-outline:hover {
            background: #f8f9fa;
            border-color: #adb5bd;
            transform: translateY(-1px);
            color: #0d6efd;
        }

    .btn-assign-driver {
        border-radius: 8px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        border: none;
        background: #0d6efd;
        color: white;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

        .btn-assign-driver:hover {
            background: #0b5ed7;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
            color: white;
        }

    .empty-state {
        padding: 4rem 2rem;
        background: #f8f9fa;
        border-radius: 12px;
        border: 2px dashed #dee2e6;
    }

    /* RESPONSIVE TABLE ADJUSTMENTS */
    @@media (max-width: 768px) {
        .modern-table thead th, .modern-table td {
            padding: 1rem 0.75rem;
            font-size: 0.9rem;
        }
            /* Sticky first column for mobile scrolling */
            .modern-table th:first-child,
            .modern-table td:first-child {
                position: sticky;
                left: 0;
                z-index: 2;
                box-shadow: 2px 0 5px rgba(0,0,0,0.1);
                background-color: #ffffff;
            }

        .modern-table th:first-child {
            z-index: 3;
            background: #1e293b !important; /* Keep header dark on mobile sticky */
        }
    }
</style>

<div class="container-fluid px-3 px-md-4 py-4">
    <!-- Page Header -->
    <div class="row mb-4 align-items-center g-3">
        <div class="col-12 col-md-6">
            <h2 class="mb-0 fw-bold text-dark">
                <i class="bi bi-truck me-2 text-primary"></i>Pending Shipments
            </h2>
            <p class="text-muted mb-0 mt-1 small">Review and assign drivers to active shipments</p>
        </div>
        <div class="col-12 col-md-6 text-md-end">
            <div class="d-flex flex-column flex-md-row gap-2 justify-content-md-end">
                <!-- Search Form -->
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <div class="search-container" style="width: 100%; max-width: 250px;">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" name="searchString" class="form-control search-input" placeholder="Search by customer..." />
                    </div>
                    <button type="submit" class="btn btn-primary btn-modern-primary px-4">Search</button>
                </form>

                <!-- Track Button -->
                <a asp-action="Track" class="btn btn-modern-outline">
                    <i class="bi bi-geo-alt me-2"></i>Track Package
                </a>
            </div>
        </div>
    </div>

    <!-- Success Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Section -->
    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table modern-table mb-0">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shipment in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">#@shipment.OrderId</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@shipment.CustomerName</div>
                                    </td>
                                    <td>
                                        <span class="text-muted">@shipment.OrderDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@shipment.TotalAmount.ToString("C")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2">
                                            <i class="bi bi-clock-fill me-1"></i>@shipment.CurrentStatus
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="AssignDriver" asp-route-id="@shipment.ShipmentId" class="btn btn-assign-driver">
                                            <i class="bi bi-person-plus-fill me-2"></i>Assign Driver
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Premium Empty State -->
                <div class="empty-state text-center">
                    <div class="bg-white rounded-circle d-inline-flex p-4 mb-3 shadow-sm">
                        <i class="bi bi-truck display-4 text-muted"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">All caught up!</h4>
                    <p class="text-muted mb-0">
                        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                        {
                            <span>No pending shipments found matching "<strong>@ViewData["CurrentFilter"]</strong>".</span>
                        }
                        else
                        {
                            <span>There are no pending shipments at this time. New orders will appear here.</span>
                        }
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}